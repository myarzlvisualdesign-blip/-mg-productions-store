{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mg-productions-store",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-04-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mg-productions-store-db",
			"database_id": "d61e4993-7dc7-4914-95ce-acfe004275d7"
		}
	],
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mg-productions-store"
		}
	]
}
